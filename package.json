    "@mdx-js/mdx": "^3.1.1",
    "framer-motion": "^12.40.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "mermaid": "^12.0.0",
    "next": "16.3.5",
    "node-forge": "^1.4.0",
