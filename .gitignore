# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.wrangler/*
.open-next/*

# production
/build

# generated at build time by scripts/generate-content-registry.mjs
/src/generated
/public/llms.txt
/public/llms-full.txt
/public/rss.xml

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.commandcode/*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# wrangler local secrets (never commit tokens)
.dev.vars
